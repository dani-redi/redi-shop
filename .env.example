# Endpoint que recebe o POST da lista de espera (JSON). Resposta esperada: { "duplicate": boolean }.
# Sem ele, o envio é simulado em dev e falha com a mensagem de erro em produção.
VITE_WAITLIST_ENDPOINT=

# Endpoint do formulário "Falar com um especialista" em /marcas (POST JSON com e-mail, idioma e UTMs).
VITE_BRAND_CONTACT_ENDPOINT=
